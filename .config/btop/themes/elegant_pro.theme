# Elegant Professional Theme
# Designed for maximum readability and aesthetics
# Transparent background (opacity < 1) supported if main_bg is empty or theme_background=False in config

# Main background, empty for terminal default/transparency
theme[main_bg]=""

# Main text color
theme[main_fg]="#c0caf5"

# Title color for boxes
theme[title]="#e0af68"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7aa2f7"

# Background color of selected item in processes box
theme[selected_bg]="#3b4261"

# Foreground color of selected item in processes box
theme[selected_fg]="#7aa2f7"

# Color of inactive/disabled text
theme[inactive_fg]="#565f89"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#bb9af7"

# Cpu box outline color
theme[cpu_box]="#565f89"

# Memory/disks box outline color
theme[mem_box]="#565f89"

# Net up/down box outline color
theme[net_box]="#565f89"

# Processes box outline color
theme[proc_box]="#565f89"

# Box divider line and small boxes line color
theme[div_line]="#414868"

# Temperature graph colors
theme[temp_start]="#7aa2f7"
theme[temp_mid]="#bb9af7"
theme[temp_end]="#f7768e"

# CPU graph colors
theme[cpu_start]="#7aa2f7"
theme[cpu_mid]="#bb9af7"
theme[cpu_end]="#f7768e"

# Mem/Disk free meter
theme[free_start]="#73daca"
theme[free_mid]="#7aa2f7"
theme[free_end]="#bb9af7"

# Mem/Disk cached meter
theme[cached_start]="#3b4261"
theme[cached_mid]="#565f89"
theme[cached_end]="#7aa2f7"

# Mem/Disk available meter
theme[available_start]="#73daca"
theme[available_mid]="#7aa2f7"
theme[available_end]="#bb9af7"

# Mem/Disk used meter
theme[used_start]="#7aa2f7"
theme[used_mid]="#bb9af7"
theme[used_end]="#f7768e"

# Download graph colors
theme[download_start]="#ff9e64"
theme[download_mid]="#f7768e"
theme[download_end]="#f7768e"

# Upload graph colors
theme[upload_start]="#7aa2f7"
theme[upload_mid]="#bb9af7"
theme[upload_end]="#f7768e"
