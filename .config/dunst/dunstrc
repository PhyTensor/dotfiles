# Dunst Configuration - Modern Hyprland Style
# Visual improvements for better UX/UI

[global]
    # Monitor & Follow
    monitor = 0
    follow = mouse
    
    # Geometry (Width, Height, Offset)
    # Dynamic width from 300 to 500, dynamic height
    width = (300, 500)
    height = 300
    origin = top-center
    offset = 0x30
    scale = 0
    notification_limit = 20

    # Progress Bar
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 5
    
    # Appearance
    # Font
    font = JetBrainsMono Nerd Font 10
    
    # Spacing & Padding
    line_height = 4
    markup = full
    
    # The format of the message.  Possible variables are:
    #   %a  appname
    #   %s  summary
    #   %b  body
    #   %i  iconname (including its path)
    #   %I  iconname (without its path)
    #   %p  progress value if set ([  0%] to [100%]) or nothing
    #   %n  progress value if set without any extra characters
    #   %%  Literal %
    format = "<b>%s</b>\n%b"
    
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    
    # Icons
    enable_recursive_icon_lookup = true
    icon_theme = breeze-dark
    icon_position = left
    min_icon_size = 32
    max_icon_size = 80
    
    # History
    sticky_history = yes
    history_length = 20
    
    # Browser / dmenu
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    
    # Styling (Catppuccin-inspired)
    transparency = 10
    gap_size = 8
    separator_height = 2
    padding = 20
    horizontal_padding = 20
    text_icon_padding = 20
    frame_width = 2
    frame_color = "#89b4fa"
    separator_color = frame
    corner_radius = 12
    
    # Mouse Interactions
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 10

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 10

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0
