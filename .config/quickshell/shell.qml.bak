import Quickshell // for PanelWindow
import Quickshell.Io // for Process type
import Quickshell.Wayland
import Quickshell.Hyprland // Hyprland IPC access
import QtQuick // for Text
import QtQuick.Layouts // for Row Layouts

Variants {
	model: Quickshell.screens;

	delegate: Component {
		PanelWindow {
			// the screen from the screens list will be injected into this property
			required property var modelData

			// we can then set the window's screen to the injected property
			screen: modelData

			id: root


			// panel configuration
			anchors {
				top: true
				left: true
				right: true
			}

			implicitHeight: 30 // height of the bar
			color: colorBackground

			Text {
				// center the bar in its parent component (the window)
				anchors.centerIn: parent

				text: "hello world"

				color: "#a9b1d6"

				font.pixelSize: 14
			}


			// THEME
			property color colorBackground: "#1a1b26"
			property color colorForeground: "#a9b1d6"
			property color colorMuted: "#444b6a"
			property color colorCyan: "#0db9d7"
			property color colorPurple: "#ad8ee6"
			property color colorRed: "#f7768e"
			property color colorYellow: "#e0af68"
			property color colorBlue: "#7aa2f7"

			// FONT
			property string fontFamily: "JetBrainsMono Nerd Font Propo"
			property int fontSize: 13

			// SYSTEM DATA
			property string kernelVersion: "Linux"
			property int cpuUsage: 0
			property int memUsage: 0
			property int diskUsage: 0
			property int volumeLevel: 0

			// CPU Tracking
			property int lastCpuIdle: 0
			property int lastCpuTotal: 0

			// Kernel Version
			Process {
				id: kernelVersionProc
				command: ["uname", "-r"]

				stdout: SplitParser {
					onRead: data => {
						if (data) kernelVersion = data.trim()
					}
				}
				Component.onCompleted: running = true
			}

			// SYSTEM STATS
			// Run shell commands with Process
			// CPU
			Process {
				id: cpuProc
				command: ["sh", "-c", "head -1 /proc/stat"]

				// SplitParser calls onRead for each line of output
				stdout: SplitParser {
					onRead: data => {
						// parse /proc/stat
						var p = data.trim().split(/\s+/)

						// p[4] is idle, p[5] is iowait (treat both as idle time for simplicity)
						var idle = parseInt(p[4]) + parseInt(p[5])

						// Sum all non-idle times (user, nice, system, irq, softirq, steal, guest)
						var total = p.slice(1, 8).reduce((a, b) => a + parseInt(b), 0)

						if (lastCpuTotal > 0) {
							// Calculate percentage: (total_diff - idle_diff) / total_diff
							cpuUsage = Math.round(100 * (1 - (idle - lastCpuIdle) / (total - lastCpuTotal)))
						}

						lastCpuTotal = total
						lastCpuIdle = idle
					}
				}

				Component.onCompleted: running = true // start the process immediately
			}

			// MEMORY
			Process {
				id: memProc
				command: ["sh", "-c", "free | grep Mem"]

				stdout: SplitParser {
					onRead: data => {
						var parts = data.trim().split(/\s+/)
						var total = parseInt(parts[1]) || 1
						var used = parseInt(parts[2]) || 0
						memUsage = Math.round(100 * used / total)
					}
				}
				Component.onCompleted: running = true
			}

			// --- VOLUME Monitoring (Requires 'amixer' or 'pactl' - using 'pactl' as it's common) ---
			// Reads volume and mute status from PulseAudio/PipeWire.
			Process {
				id: volProc
				// Get sink info for the default sink
				command: ["sh", "-c", "pactl get-sink-volume @DEFAULT_SINK@ | grep -oE '[0-9]+%' | head -1; pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}'"]
				stdout: SplitParser {
					onRead: data => {
						var lines = data.split('\n')
						// Extract volume percentage (e.g., "50%") and convert to integer
						if (lines[0]) {
							volumeLevel = parseInt(lines[0].replace('%', '')) || 0
						}
						// Check mute status ("yes" or "no")
						if (lines[1]) {
							isMuted = lines[1].trim() === "yes"
						}
					}
				}
				Component.onCompleted: running = true
			}

			// --- SYSTEM REFRESH TIMER ---
			// Timer to refresh every 2 seconds
			Timer {
				interval: 2000
				running: true
				repeat: true
				onTriggered: {
					cpuProc.running = true
					memProc.running = true
					volProc.running = true
				}
			}

			// Row Layout arranges children horizontally
			RowLayout {
				anchors {
					fill: parent
					margins: 8 // padding inside the bar
				}

				spacing: 8 // spacing between modules

				// CLOCK
				Text {
					id: clock

					property bool isFull: false

					text: Qt.formatDateTime(new Date(), "HH:mm:ss")
					color: root.colorBlue

					font {
						family: root.fontFamily
						pixelSize: root.fontSize
						bold: true
					}

					Timer {
						interval: 10
						running: true
						repeat: true
						onTriggered: {
							clock.text = clock.isFull
							? Qt.formatDateTime(new Date(), "ddd, dd MMM | yyyy")
							: Qt.formatDateTime(new Date(), "HH:mm:ss")
						}
					}

					MouseArea {
						anchors.fill: parent
						onClicked: clock.isFull = !clock.isFull
					}
				}

				Rectangle {
					width: 1
					height: 16
					color: root.colorMuted
				}

				// WORKSPACES
				// Repeater creates 10 copies, each gets an index (0-8)
				Repeater {
					model: 10

					Text {
						property int wsId: index + 1

						// Live data from Hyprland IPC
						property var ws: Hyprland.workspaces.values.find(w => w.id === wsId)
						property bool isActive: Hyprland.focusedWorkspace?.id === (wsId)

						text: wsId === 10 ? "0" : wsId.toString()

						// Color logic: cyan = active, blue = has windows, gray = empty
						color: isActive ? root.colorCyan : (ws ? root.colorBlue : root.colorMuted)

						font {
							family: root.fontFamily
							pixelSize: root.fontSize
							bold: true
						}

						// Click to switch workspaces
						MouseArea {
							anchors.fill: parent
							onClicked: Hyprland.dispatch("workspace " + (wsId))
						}
					}
				}

				// Add an item to act as a spacer that pushes everything to the right
				Item {
					Layout.fillWidth: true
				}

				Text {
					// icon: "\ue266" //  (Nerd Font: Chip)
					text: "\ue266 " + cpuUsage + "%"
					color: root.colorYellow
					font {
						family: root.fontFamily
						pixelSize: root.fontSize
						bold: true
					}
					Layout.rightMargin: 4
				}

				Rectangle {
					width: 1
					height: 16
					color: root.colorMuted
				}

				Text {
					text: "\uf2dc " + memUsage + "%"
					color: memUsage > 80 ? root.colorRed : root.colorCyan // Red alert if high
					// color: root.colorCyan
					font {
						family: root.fontFamily
						pixelSize: root.fontSize
						bold: true
					}
				}

				Rectangle {
					width: 1
					height: 16
					color: root.colorMuted
				}
			}

			// =======================================================
			// # HELPER COMPONENTS (For readability and reusability)
			// =======================================================

			// A simple, reusable divider rectangle
			// Component {
			//     id: Divider
			//     Rectangle {
			//         width: 1
			//         height: root.fontSize + 4
			//         color: root.colorMuted
			//     }
			// }
			//
			// // A compact module for status display (Icon + Text)
			// Component {
			//     id: MinimalModule
			//     RowLayout {
			//         // Define properties for easy use
			//         property string icon: ""
			//         property string text: ""
			//         property color color: root.colorForeground
			//
			//         spacing: 4
			//
			//         // Icon Text
			//         Text {
			//             text: MinimalModule.icon
			//             color: MinimalModule.color
			//             font {
			//                 family: root.fontFamily
			//                 pixelSize: root.fontSize
			//             }
			//         }
			//
			//         // Status Text
			//         Text {
			//             text: MinimalModule.text
			//             color: MinimalModule.color
			//             font {
			//                 family: root.fontFamily
			//                 pixelSize: root.fontSize
			//                 bold: true
			//             }
			//         }
			//     }
			// }
		}


	}
}

